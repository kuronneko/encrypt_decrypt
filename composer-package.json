{
    "name": "kuronneko/laravel-devextreme-encrypted",
    "description": "Laravel DevExtreme integration with encrypted fields support and optimized pagination",
    "type": "library",
    "keywords": [
        "laravel",
        "devextreme",
        "encryption",
        "pagination",
        "datagrid",
        "optimization"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "kuronneko",
            "email": "your-email@example.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "laravel/framework": "^10.0|^11.0",
        "illuminate/support": "^10.0|^11.0",
        "illuminate/database": "^10.0|^11.0",
        "illuminate/encryption": "^10.0|^11.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "orchestra/testbench": "^8.0|^9.0",
        "mockery/mockery": "^1.5"
    },
    "autoload": {
        "psr-4": {
            "Kuronneko\\LaravelDevExtremeEncrypted\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kuronneko\\LaravelDevExtremeEncrypted\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Kuronneko\\LaravelDevExtremeEncrypted\\DevExtremeEncryptedServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    }
}
